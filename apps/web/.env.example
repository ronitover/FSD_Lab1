# Copy to .env (or .env.local) for local development. Never commit real values.
# Everything prefixed VITE_ ends up in the browser bundle, so only public values belong here.

# Base URL of the API. Leave unset locally: Vite forwards /api to http://localhost:5001.
# VITE_API_URL=https://api.replate.example

# Supabase project → Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Safe in the browser; Row Level Security protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
