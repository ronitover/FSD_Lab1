# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=5001
LOG_LEVEL=info

# Web origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Supabase project → Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Used to query as the signed-in user, so Row Level Security applies to every request.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Bypasses Row Level Security. The API server does not use it; only the db:check and api:check
# scripts do, to create and delete test accounts. Leave it out of production environments.
SUPABASE_SECRET_KEY=sb_secret_...

# Address search (OpenStreetMap Nominatim). Their usage policy asks for a contact in the User-Agent.
NOMINATIM_CONTACT=RePlate (you@example.com)
# Restrict address search to these ISO country codes (comma-separated); leave empty for worldwide.
NOMINATIM_COUNTRY_CODES=in
