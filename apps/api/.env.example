# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=5001
LOG_LEVEL=info

# Web origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Supabase project → Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Used to query as the signed-in user, so Row Level Security applies to every request.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses Row Level Security: used for admin tasks and the db:check script.
SUPABASE_SECRET_KEY=sb_secret_...
